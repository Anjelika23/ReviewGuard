# Copy this file to .env only when using a dotenv loader, or set these variables
# in your terminal. Django does not load .env automatically in this starter.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_TIME_ZONE=Asia/Kolkata
FAKE_THRESHOLD=0.5

# Optional PostgreSQL configuration. Leave DB_NAME unset to use SQLite.
# DB_NAME=reviewguard
# DB_USER=postgres
# DB_PASSWORD=change-this
# DB_HOST=localhost
# DB_PORT=5432

# Optional NLP enhancement (install spaCy and its English model first).
# FRD_USE_SPACY=1
