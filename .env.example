# ==========================================
# ReviewGuard — Environment Configuration
# ==========================================

# Django Core Settings
DJANGO_SECRET_KEY=replace-with-a-secure-random-key-for-production
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=*,127.0.0.1,localhost,.onrender.com,.railway.app
DJANGO_TIME_ZONE=Asia/Kolkata

# ML Decision Engine
FAKE_THRESHOLD=0.5

# Security & Reverse Proxy Settings
# Set SECURE_SSL_REDIRECT=1 only when SSL termination is managed by Django rather than cloud reverse proxy
SECURE_SSL_REDIRECT=0
SESSION_COOKIE_SECURE=1
CSRF_COOKIE_SECURE=1
CSRF_TRUSTED_ORIGINS=https://*.onrender.com,https://*.railway.app,https://*.herokuapp.com

# Database Settings
# For Render / Railway / Heroku (automatic Postgres injection):
# DATABASE_URL=postgres://user:password@host:5432/dbname
#
# Alternatively, manual Postgres fields:
# DB_NAME=reviewguard
# DB_USER=postgres
# DB_PASSWORD=your-secure-password
# DB_HOST=localhost
# DB_PORT=5432
#
# Leave DATABASE_URL and DB_NAME unset to use SQLite (db.sqlite3) automatically.

# Optional Advanced NLP
# FRD_USE_SPACY=0
